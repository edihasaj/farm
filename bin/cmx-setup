#!/usr/bin/env bash
set -euo pipefail

command -v jq >/dev/null 2>&1 || { printf 'cmx setup: jq is required\n' >&2; exit 1; }
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
event="$root/bin/cmx-agent-event"

install_codex() {
  local file=$1 tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/cmx-hooks.XXXXXX")
  jq --arg event "$event" '
    def farm($state): {hooks:[{type:"command", command:($event + " " + $state + " codex"), timeout:10}]};
    .hooks.SessionStart = ((.hooks.SessionStart // []) | map(select((.hooks[0].command // "") | contains("cmux codex-hook") | not)) + [farm("idle")]) |
    .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | map(select((.hooks[0].command // "") | contains("cmux codex-hook") | not)) + [farm("working")]) |
    .hooks.Stop = ((.hooks.Stop // []) | map(select((.hooks[0].command // "") | contains("cmux codex-hook") | not)) + [farm("done")])
  ' "$file" >"$tmp"
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}

install_claude() {
  local file=$1 tmp
  [[ -f $file ]] || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/cmx-hooks.XXXXXX")
  jq --arg event "$event" '
    def farm($state): {hooks:[{type:"command", command:($event + " " + $state + " claude"), timeout:10}]};
    def without_farm: map(select((.hooks[0].command // "") | contains("/cmx-agent-event ") | not));
    .hooks.SessionStart = ((.hooks.SessionStart // []) | without_farm + [farm("idle")]) |
    .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | without_farm + [farm("working")]) |
    .hooks.Stop = ((.hooks.Stop // []) | without_farm + [farm("done")]) |
    .hooks.SessionEnd = ((.hooks.SessionEnd // []) | without_farm + [farm("idle")])
  ' "$file" >"$tmp"
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}

install_codex "$HOME/.codex/hooks.json"
install_codex "$HOME/.codex-work/hooks.json"
install_claude "$HOME/.claude/settings.json"
printf 'cmx setup: installed Codex and Claude running/done hooks\n'
