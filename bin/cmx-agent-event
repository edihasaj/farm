#!/usr/bin/env bash
set -u

state=${1:-}
agent=${2:-agent}
case $state in working|done|idle) ;; *) printf '{}\n'; exit 0 ;; esac

input=$(cat 2>/dev/null || true)
if [[ -n ${TMUX_PANE:-} ]] && command -v tmux >/dev/null 2>&1; then
  session=$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null || true)
  if [[ -n $session ]]; then
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/farm/agents"
    mkdir -p "$state_dir"
    state_file="$state_dir/$session"
    summary=''
    summary_source=''
    summary_key=''
    if [[ -n $input ]] && command -v jq >/dev/null 2>&1; then
      summary_source=$(jq -r '
        [
          .thread_title?, .threadTitle?, .session_title?, .sessionTitle?, .title?,
          .prompt?, .user_prompt?, .userPrompt?
        ] | map(select(type == "string" and length > 0)) | .[0] // empty
      ' <<<"$input" 2>/dev/null || true)
    fi
    if [[ -n $summary_source ]]; then
      summary_source=$(printf '%s' "$summary_source" | tr '\r\n\t' '   ' | sed -E 's/<[^>]+>/ /g; s/[[:space:]]+/ /g; s/^ //; s/ $//' | cut -c1-500)
      summary=$(printf '%s' "$summary_source" | awk '{for (i=1; i<=NF && i<=9; i++) printf "%s%s", (i>1?" ":""), $i; if (NF>9) printf "…"; print ""}')
      summary_key=$(printf '%s' "$summary_source" | shasum -a 256 | awk '{print $1}')
    elif [[ -r $state_file ]]; then
      summary=$(sed -n 's/^summary=//p' "$state_file" | head -1)
      summary_key=$(sed -n 's/^summary_key=//p' "$state_file" | head -1)
    fi
    tmp="$state_dir/.${session}.$$"
    umask 077
    printf 'state=%s\nagent=%s\nevent=%s-%s\nsummary=%s\nsummary_key=%s\n' "$state" "$agent" "$(date +%s)" "$$" "$summary" "$summary_key" >"$tmp"
    mv -f "$tmp" "$state_file"
    if [[ $state == working && -n $summary_source && -n $summary_key ]]; then
      summarizer=${CMX_SUMMARIZER:-"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cmx-summarize"}
      if [[ -x $summarizer ]]; then
        printf '%s' "$summary_source" | nohup "$summarizer" "$agent" "$session" "$state_file" "$summary_key" >/dev/null 2>&1 &
      fi
    fi
  fi
fi
printf '{}\n'
