#!/usr/bin/env bash
set -euo pipefail

cmux=${CMUX_BIN:-/Applications/cmux.app/Contents/Resources/bin/cmux}
registry="${XDG_CONFIG_HOME:-$HOME/.config}/farm/cmx-workspaces.tsv"
command -v jq >/dev/null 2>&1 || { printf 'cmx restore: jq is required\n' >&2; exit 1; }

workspaces=$($cmux workspace list --json)
if [[ ! -s $registry ]]; then
  host=${CMX_HOST:-studio}
  ssh_bin=${CMX_SSH_BIN:-ssh}
  sessions=$($ssh_bin -o BatchMode=yes -o ConnectTimeout=8 -o RequestTTY=no \
    -o RemoteCommand=none "$host" "tmux list-sessions -F '#{session_name}'" 2>/dev/null || true)
  mkdir -p "$(dirname "$registry")"
  self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cmx
  while IFS=$'\t' read -r title; do
    [[ -n $title ]] || continue
    grep -Fxq "$title" <<<"$sessions" || continue
    printf -v command '%q %q --attach -H %q -d %q' "$self" "$title" "$host" "~/Projects/$title"
    printf '%s\t%s\t%s\n' "$title" "$title" "$command" >>"$registry"
  done < <(jq -r '.workspaces[]? | select(.remote.enabled == false) | [.title] | @tsv' \
    <<<"${workspaces:-{\"workspaces\":[]}}" 2>/dev/null || true)
fi
[[ -s $registry ]] || { printf 'cmx restore: no registered or discoverable workspaces\n' >&2; exit 1; }

restored=0
missing=0
while IFS=$'\t' read -r session title command; do
  [[ -n $session && -n $command ]] || continue
  ref=$(jq -r --arg title "$title" '.workspaces[]? | select(.title == $title and .remote.enabled == false) | .ref' <<<"$workspaces" | tail -1)
  if [[ -z $ref ]]; then
    printf 'cmx restore: missing workspace %s; run `cmx %s -w`\n' "$title" "$session" >&2
    missing=$((missing + 1))
    continue
  fi
  "$cmux" respawn-pane --workspace "$ref" --command "$command" >/dev/null
  printf 'restored %s (%s)\n' "$title" "$ref"
  restored=$((restored + 1))
done <"$registry"

printf 'cmx restore: %s restored, %s missing\n' "$restored" "$missing"
(( missing == 0 ))
