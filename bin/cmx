#!/usr/bin/env bash
# Stable local-cmux view over SSH + Studio tmux.
set -euo pipefail

CMX_VERSION=3

usage() {
  cat <<'EOF'
Usage:
  cmx <project> [options]       attach in the current terminal
  cmx <project> --new           next independent session, same project
  cmx <project> --slot <name>   explicit independent session
  cmx <project> -w              create a local cmux workspace for the session
  cmx restore                   reattach registered workspaces after a restart
  cmx list                      list current cmux workspaces
  cmx sessions                  list persistent Studio tmux sessions
  cmx setup                     install running/done agent hooks

Project options:
  -H, --host <ssh-alias>        remote host (default: studio)
  -d, --dir <remote-path>       initial directory (default: ~/Projects/<project>)
  -s, --slot <name>             session suffix: project-<name>
      --new                     choose the next free session automatically
  -c, --command <command>       run only when creating a fresh tmux session
  -w, --workspace               open in a grouped local cmux workspace
  -n, --name <title>            workspace title
      --no-focus                create workspace without focusing it
      --mosh                    use Mosh instead of SSH (no image upload)

Examples:
  cmx manager                    # current terminal, session manager
  cmx oktapod --new              # oktapod-2, then oktapod-3, ...
  cmx oktapod --slot review      # explicit session oktapod-review
  cmx manager -w                 # local cmux view, persistent Studio tmux
  cmx api -H gpu-box -d ~/work/api
  cmx restore

Running the same project without --new/--slot attaches the same tmux session,
so multiple terminals mirror it. Use --new for independent terminals that share
one project directory. `-w` creates a grouped local workspace and a restore
binding. In current-terminal mode, `exit` closes the session; Ctrl-b d keeps it
running. Close a workspace with Cmd+Shift+W.
EOF
}

die() {
  printf 'cmx: %s\n' "$*" >&2
  exit 2
}

find_cmux() {
  if [[ -n "${CMUX_BIN:-}" ]]; then
    printf '%s\n' "$CMUX_BIN"
  elif command -v cmux >/dev/null 2>&1; then
    command -v cmux
  elif [[ -x /Applications/cmux.app/Contents/Resources/bin/cmux ]]; then
    printf '%s\n' /Applications/cmux.app/Contents/Resources/bin/cmux
  else
    die 'cmux CLI not found; install cmux in /Applications or set CMUX_BIN'
  fi
}

find_mosh() {
  if [[ -n "${CMX_MOSH_BIN:-}" ]]; then
    printf '%s\n' "$CMX_MOSH_BIN"
  elif command -v mosh >/dev/null 2>&1; then
    command -v mosh
  else
    die 'mosh not found; install Mosh or use --workspace for cmux fallback'
  fi
}

find_ssh() {
  if [[ -n "${CMX_SSH_BIN:-}" ]]; then
    printf '%s\n' "$CMX_SSH_BIN"
  elif command -v ssh >/dev/null 2>&1; then
    command -v ssh
  else
    die 'ssh not found'
  fi
}

script_path() {
  local source=${BASH_SOURCE[0]}
  while [[ -L $source ]]; do
    local dir
    dir=$(cd -P "$(dirname "$source")" && pwd)
    source=$(readlink "$source")
    [[ $source == /* ]] || source="$dir/$source"
  done
  printf '%s\n' "$(cd -P "$(dirname "$source")" && pwd)/$(basename "$source")"
}

remote_cd_command() {
  local path=$1 quoted
  case $path in
    '~/'*)
      printf -v quoted '%q' "${path#\~/}"
      printf 'cd -- "$HOME"/%s' "$quoted"
      ;;
    *)
      printf -v quoted '%q' "$path"
      printf 'cd -- %s' "$quoted"
      ;;
  esac
}

case ${1:-} in
  ''|-h|--help|help)
    usage
    exit 0
    ;;
  --version)
    printf 'cmx %s\n' "$CMX_VERSION"
    exit 0
    ;;
  restore|resume)
    shift
    (( $# == 0 )) || die 'restore takes no arguments'
    exec "$(dirname "$(script_path)")/cmx-restore"
    ;;
  list|ls)
    shift
    CMUX="$(find_cmux)"
    exec "$CMUX" workspace list "$@"
    ;;
  sessions)
    shift
    (( $# <= 1 )) || die 'usage: cmx sessions [host]'
    SSH_BIN="$(find_ssh)"
    exec "$SSH_BIN" -o RequestTTY=no -o RemoteCommand=none "${1:-${CMX_HOST:-studio}}" \
      "tmux list-sessions -F '#{session_name}: #{session_windows} windows'"
    ;;
  setup|hooks)
    shift
    (( $# == 0 )) || die 'setup takes no arguments'
    exec "$(dirname "$(script_path)")/cmx-setup"
    ;;
esac

project=''
host=${CMX_HOST:-studio}
directory=''
title=''
launch_command=''
slot=''
auto_new=0
native_workspace=0
use_mosh=0
attach_only=0
passthrough=()

while (( $# > 0 )); do
  case $1 in
    -H|--host)
      (( $# >= 2 )) || die "$1 requires a host"
      host=$2
      shift 2
      ;;
    -d|--dir)
      (( $# >= 2 )) || die "$1 requires a path"
      directory=$2
      shift 2
      ;;
    -s|--slot)
      (( $# >= 2 )) || die "$1 requires a slot"
      slot=$2
      shift 2
      ;;
    --new)
      auto_new=1
      shift
      ;;
    -w|--workspace)
      native_workspace=1
      shift
      ;;
    --mosh)
      use_mosh=1
      shift
      ;;
    --attach)
      attach_only=1
      shift
      ;;
    -n|--name)
      (( $# >= 2 )) || die "$1 requires a title"
      title=$2
      shift 2
      ;;
    -c|--command)
      (( $# >= 2 )) || die "$1 requires a command"
      launch_command=$2
      shift 2
      ;;
    --no-focus)
      passthrough+=("$1")
      shift
      ;;
    -p|--port|-i|--identity|-o|--ssh-option|--window)
      (( $# >= 2 )) || die "$1 requires a value"
      passthrough+=("$1" "$2")
      shift 2
      ;;
    -A|-a|--forward-agent|--no-forward-agent)
      passthrough+=("$1")
      shift
      ;;
    --)
      shift
      passthrough+=("$@")
      break
      ;;
    -*) die "unknown option: $1" ;;
    *)
      [[ -z $project ]] || die "unexpected argument: $1"
      project=$1
      shift
      ;;
  esac
done

[[ -n $project ]] || die 'missing project name; run `cmx --help`'
[[ $project =~ ^[A-Za-z0-9_-]+$ ]] || die 'project must use letters, numbers, _ or -'
[[ -n $host ]] || die 'host cannot be empty'
[[ -z $slot || $slot =~ ^[A-Za-z0-9_-]+$ ]] || die 'slot must use letters, numbers, _ or -'
(( auto_new == 0 )) || [[ -z $slot ]] || die 'use either --new or --slot, not both'

session=$project
if [[ -n $slot && $slot != 1 && $slot != main ]]; then
  session="$project-$slot"
elif (( auto_new )); then
  SSH_BIN="$(find_ssh)"
  existing_sessions="$("$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=8 \
    -o RequestTTY=no -o RemoteCommand=none "$host" \
    "tmux list-sessions -F '#{session_name}' 2>/dev/null || true")" \
    || die "cannot list tmux sessions on $host"
  if grep -Fxq "$project" <<<"$existing_sessions"; then
    for candidate in $(seq 2 99); do
      if ! grep -Fxq "$project-$candidate" <<<"$existing_sessions"; then
        session="$project-$candidate"
        break
      fi
    done
  fi
fi

directory=${directory:-"~/Projects/$project"}

attach_session() {
  local transport remote_script watcher_pid=''
  printf -v quoted_session '%q' "$session"
  printf -v quoted_directory '%q' "$directory"
  printf -v quoted_command '%q' "$launch_command"
  remote_script="session=$quoted_session; directory=$quoted_directory; launch_command=$quoted_command; "
  remote_script+='case "$directory" in "~/"*) directory="$HOME/${directory#\~/}" ;; esac; '
  remote_script+='[ -d "$directory" ] || directory="$HOME/Projects"; created=0; '
  remote_script+='target="=$session"; window_target="=$session:"; '
  remote_script+='if ! tmux has-session -t "$target" 2>/dev/null; then tmux new-session -d -s "$session" -c "$directory" -e ZDOTDIR="$HOME"; created=1; fi; '
  remote_script+='tmux set-environment -t "$target" ZDOTDIR "$HOME"; '
  remote_script+='tmux set-option -w -t "$window_target" remain-on-exit off; '
  remote_script+='tmux set-hook -uw -t "$window_target" pane-died 2>/dev/null || true; '
  remote_script+='if [ "$created" = 1 ] && [ -n "$launch_command" ]; then tmux send-keys -t "$window_target" "$launch_command" Enter; fi; '
  remote_script+='exec tmux attach-session -t "$target"'

  if [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
    local cmux self resume
    cmux=$(find_cmux)
    self=$(script_path)
    printf -v resume '%q %q --attach -H %q -d %q' "$self" "$project" "$host" "$directory"
    [[ -z $slot ]] || printf -v resume '%s --slot %q' "$resume" "$slot"
    (( use_mosh == 0 )) || resume+=' --mosh'
    "$cmux" surface resume set --workspace "$CMUX_WORKSPACE_ID" \
      --kind tmux --checkpoint "$session" --name "$session" --shell "$resume" >/dev/null 2>&1 || true
    "$(dirname "$self")/cmx-watch" "$session" "$CMUX_WORKSPACE_ID" "$host" &
    watcher_pid=$!
    trap '[[ -z ${watcher_pid:-} ]] || kill "$watcher_pid" 2>/dev/null || true' EXIT HUP INT TERM
  fi

  if (( use_mosh )); then
    transport=$(find_mosh)
    "$transport" --predict="${CMX_PREDICT:-adaptive}" \
      --ssh="$(find_ssh) -o RequestTTY=no -o RemoteCommand=none" \
      "$host" -- /bin/bash -lc "$remote_script"
  else
    transport=$(find_ssh)
    printf -v quoted_remote '%q' "$remote_script"
    "$transport" -tt -o ServerAliveInterval=20 -o ServerAliveCountMax=2 \
      -o ControlMaster=auto -o ControlPersist=60 -o 'ControlPath=~/.ssh/cmux-%C' \
      -o RemoteCommand=none "$host" "/bin/bash -lc $quoted_remote"
  fi
}

if (( native_workspace == 0 || attach_only == 1 )); then
  (( ${#passthrough[@]} == 0 )) || die 'cmux flags require --workspace'
  [[ -z $title ]] || die '--name requires --workspace'
  attach_session
  exit $?
fi

(( use_mosh == 0 )) || die '--mosh is for current-terminal attachment'
title=${title:-$session}
CMUX="$(find_cmux)"
self=$(script_path)
printf -v workspace_command '%q %q --attach -H %q -d %q' "$self" "$project" "$host" "$directory"
[[ -z $slot ]] || printf -v workspace_command '%s --slot %q' "$workspace_command" "$slot"

focus=true
if (( ${#passthrough[@]} > 0 )); then
  for arg in "${passthrough[@]}"; do
    [[ $arg != --no-focus ]] || focus=false
  done
fi
output=$("$CMUX" workspace create --name "$title" --cwd "$HOME/Projects" \
  --command "$workspace_command" --focus "$focus")
printf '%s\n' "$output"
workspace_ref=$(sed -nE 's/.*workspace=(workspace:[0-9]+).*/\1/p' <<<"$output" | head -1)
if [[ -n $workspace_ref ]] && command -v jq >/dev/null 2>&1; then
  group_ref=$("$CMUX" workspace-group list --json 2>/dev/null | jq -r --arg name "$project" '.groups[]? | select(.name == $name) | .ref' | head -1)
  if [[ -n $group_ref ]]; then
    "$CMUX" workspace-group add --group "$group_ref" --workspace "$workspace_ref" >/dev/null
  else
    "$CMUX" workspace-group create --name "$project" --from "$workspace_ref" >/dev/null
  fi
fi

registry="${XDG_CONFIG_HOME:-$HOME/.config}/farm/cmx-workspaces.tsv"
mkdir -p "$(dirname "$registry")"
registry_tmp=$(mktemp "${TMPDIR:-/tmp}/cmx-registry.XXXXXX")
if [[ -f $registry ]]; then
  awk -F '\t' -v session="$session" '$1 != session' "$registry" >"$registry_tmp"
fi
printf '%s\t%s\t%s\n' "$session" "$title" "$workspace_command" >>"$registry_tmp"
mv -f "$registry_tmp" "$registry"
