#!/usr/bin/env bash
set -u

session=${1:?usage: cmx-watch <session> <workspace> [host]}
workspace=${2:?usage: cmx-watch <session> <workspace> [host]}
host=${3:-studio}
cmux=${CMUX_BIN:-/Applications/cmux.app/Contents/Resources/bin/cmux}
ssh_bin=${CMX_SSH_BIN:-ssh}
last=''
initialized=0
lock_root="${XDG_STATE_HOME:-$HOME/.local/state}/farm/cmx-watch"
lock="$lock_root/$workspace"
mkdir -p "$lock_root"
if ! mkdir "$lock" 2>/dev/null; then
  old_pid=$(sed -n '1p' "$lock/pid" 2>/dev/null || true)
  if [[ -n $old_pid ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
  mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock/pid"

cleanup() {
  "$cmux" workspace loading off --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

while :; do
  printf -v quoted_session '%q' "$session"
  current=$("$ssh_bin" -o BatchMode=yes -o ConnectTimeout=4 -o RequestTTY=no \
    -o RemoteCommand=none "$host" \
    "file=\"\${XDG_STATE_HOME:-\$HOME/.local/state}/farm/agents/$quoted_session\"; test ! -r \"\$file\" || cat \"\$file\"" 2>/dev/null || true)
  if [[ -n $current && $current != "$last" ]]; then
    state=$(sed -n 's/^state=//p' <<<"$current" | head -1)
    agent=$(sed -n 's/^agent=//p' <<<"$current" | head -1)
    if [[ $state == working ]]; then
      "$cmux" workspace loading on --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
    else
      "$cmux" workspace loading off --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
      if (( initialized )) && [[ $state == "done" ]]; then
        "$cmux" notify --workspace "$workspace" --title "${agent:-Agent}" \
          --body "$session finished" >/dev/null 2>&1 || true
      fi
    fi
    last=$current
    initialized=1
  elif (( initialized == 0 )); then
    initialized=1
  fi
  sleep "${CMX_WATCH_INTERVAL:-2}"
done
