#!/usr/bin/env bash
set -u

session=${1:?usage: cmx-watch <session> <workspace> [host]}
workspace=${2:?usage: cmx-watch <session> <workspace> [host]}
host=${3:-studio}
cmux=${CMUX_BIN:-/Applications/cmux.app/Contents/Resources/bin/cmux}
ssh_bin=${CMX_SSH_BIN:-ssh}
last=''
initialized=0
last_event=''
lock_root="${XDG_STATE_HOME:-$HOME/.local/state}/farm/cmx-watch"
lock="$lock_root/$workspace"
mkdir -p "$lock_root"
if ! mkdir "$lock" 2>/dev/null; then
  old_pid=$(sed -n '1p' "$lock/pid" 2>/dev/null || true)
  if [[ -n $old_pid ]] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
  mkdir "$lock" 2>/dev/null || exit 0
fi
printf '%s\n' "$$" >"$lock/pid"

cleanup() {
  "$cmux" workspace loading off --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
  rm -f "$lock/pid"
  rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

while :; do
  printf -v quoted_session '%q' "$session"
  current=$("$ssh_bin" -o BatchMode=yes -o ConnectTimeout=4 -o RequestTTY=no \
    -o RemoteCommand=none "$host" \
    "file=\"\${XDG_STATE_HOME:-\$HOME/.local/state}/farm/agents/$quoted_session\"; test ! -r \"\$file\" || cat \"\$file\"; screen=\$(tmux capture-pane -p -t '=$quoted_session:' -S -12 2>/dev/null || true); if grep -Eq 'Pursuing goal|esc to interrupt|background terminal running' <<<\"\$screen\"; then echo screen=working; elif grep -Eq 'Goal achieved|Worked for' <<<\"\$screen\"; then echo screen=idle; fi" 2>/dev/null || true)
  if [[ -n $current && $current != "$last" ]]; then
    event_state=$(sed -n 's/^state=//p' <<<"$current" | head -1)
    event=$(sed -n 's/^event=//p' <<<"$current" | head -1)
    screen_state=$(sed -n 's/^screen=//p' <<<"$current" | head -1)
    agent=$(sed -n 's/^agent=//p' <<<"$current" | head -1)
    summary=$(sed -n 's/^summary=//p' <<<"$current" | head -1)
    state=${screen_state:-$event_state}
    if [[ -n $summary ]]; then
      "$cmux" rename-workspace --workspace "$workspace" "$summary" >/dev/null 2>&1 || true
      "$cmux" set-status farm-task "$summary" --icon text.bubble --color '#5AC8FA' \
        --priority 70 --workspace "$workspace" >/dev/null 2>&1 || true
    fi
    if [[ $state == working ]]; then
      "$cmux" workspace loading on --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
    else
      "$cmux" workspace loading off --id farm-agent --workspace "$workspace" >/dev/null 2>&1 || true
      if (( initialized )) && [[ $event_state == "done" && -n $event && $event != "$last_event" ]]; then
        "$cmux" notify --workspace "$workspace" --title "${agent:-Agent}" \
          --body "$session finished" >/dev/null 2>&1 || true
      fi
    fi
    [[ -z $event ]] || last_event=$event
    last=$current
    initialized=1
  elif (( initialized == 0 )); then
    initialized=1
  fi
  sleep "${CMX_WATCH_INTERVAL:-2}"
done
